{
	"name": "redux-persist-transform-expire-in",
	"version": "1.1.3",
	"description": "A redux-persist transform that resets persisted state after a period of inactivity.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"check": "biome check --write .",
		"test": "node --test \"src/**/*.test.ts\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"src/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirLisko/redux-persist-transform-expire-in.git"
	},
	"keywords": [
		"redux",
		"redux-persist",
		"redux-persist-transform",
		"expire",
		"expiration",
		"ttl"
	],
	"author": "Luca Lischetti <luca@sirlisko.com> (https://sirlisko.com)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sirLisko/redux-persist-transform-expire-in/issues"
	},
	"homepage": "https://github.com/sirLisko/redux-persist-transform-expire-in#readme",
	"peerDependencies": {
		"redux": ">=4",
		"redux-persist": ">=5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24.19.2",
		"redux": "^5.0.1",
		"redux-persist": "^6.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.7.0"
}
